# Copy to .env and fill in. .env is gitignored and must never be committed.

# Contact address sent in the User-Agent of every outbound API request (SPEC §9.1).
# Deliberately NOT shown on the public /attributions page — it exists so a data
# provider can reach us, not for the audience.
CONTACT_EMAIL=

# Phase 1+ credentials. Leave blank until the source is actually enabled.
# OpenSky OAuth2 client credentials (see docs/verification.md — licence is unresolved)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# NJ TRANSIT developer credentials (Phase 2)
NJT_USERNAME=
NJT_PASSWORD=

# aisstream.io API key (Phase 3)
AISSTREAM_KEY=

# Admin page password (SPEC §9.5)
ADMIN_PASSWORD=
