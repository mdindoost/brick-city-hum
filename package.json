{
  "name": "brick-city-hum",
  "version": "0.1.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "setup": "git config core.hooksPath .githooks && echo 'git hooks enabled'",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:samples",
    "lab:bundle": "vite build --config lab/vite.bundle.config.ts",
    "lab:render": "npm run lab:bundle && tsx lab/render.ts",
    "lab:analyze": "python3 lab/analyze.py",
    "build:client": "vite build",
    "demo": "npm run build:client && tsx server/src/dev-replay.ts",
    "test:samples": "python3 tools/test-sample-pitch.py",
    "samples": "python3 tools/fetch-samples.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdindoost/brick-city-hum.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mdindoost/brick-city-hum/issues"
  },
  "homepage": "https://github.com/mdindoost/brick-city-hum#readme",
  "description": "A live, browser-based radio that turns Newark into music.",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/suncalc": "^1.9.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@types/web": "^0.0.358",
    "suncalc": "^2.1.1",
    "tone": "^15.1.22",
    "tsx": "^4.23.15",
    "ulid": "^3.0.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
